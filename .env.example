# Copy this file to .env for local development. NEVER commit .env.

# PostgreSQL connection string. Leave EMPTY locally to use the built-in
# embedded Postgres (PGlite, stored in .data/pglite). REQUIRED in production.
# On Render use the "Internal Database URL" of your Render PostgreSQL instance.
DATABASE_URL=

# Set to "true" only if your database requires SSL and you use an EXTERNAL url.
# (Render's Internal Database URL does not need it.)
DATABASE_SSL=false

# Optional but STRONGLY recommended on a public deployment: one password that
# protects every private API endpoint. Leave empty to disable login (local use only).
APP_PASSWORD=

# Long random string used to sign login tokens (e.g. output of: openssl rand -hex 32)
SESSION_SECRET=

PORT=3000
NODE_ENV=development
